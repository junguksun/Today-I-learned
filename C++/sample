	virtual void Initialize()PURE;
	virtual void Update()PURE;
	virtual int Late_Update()PURE;
	virtual void Render(HDC hDC)PURE;
	virtual void Release()PURE;
public:
	void Update_RECT();
private:
	INFO m_tInfo = { 0.f, 0.f, 0.f, 0.f };
	POINT m_tCenter = {0, 0};
	float fSpeed = 0.f;
	RECT m_tRect = { 0, 0, 0, 0 };
	float m_fAngle = 0.f;
	float m_fEndX = 0.f;
