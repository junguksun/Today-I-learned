int CMonster::Update() {
	float fDistanceX = m_pPlayer->Get().fX - m_tInfo.fX;  // 목적지가 어디인지 봐야한다. 벡터여서
	float fDistanceY = m_pPlayer->Get().fY - m_tInfo.fY;  // 목적지 - 출발지 (벡터 쪼개짐 생각~) >> 이해 함!
	float fDistance = sqrtf(((fDistanceX * fDistanceX) + (fDistanceY * fDistanceY)));
	m_fAngle = acosf(fDistanceX / fDistance);

	if (m_tInfo.fY > m_pPlayer->Get().fY) {   // 나는 데카르트로 생각했으니까, 쓸 때는 반대로!
		m_fAngle = (2.f * PIE)*(PIE / 180.f) - m_fAngle;
	}
	m_tInfo.fX += m_fSpeed * cosf(m_fAngle);
	m_tInfo.fY += m_fSpeed * sinf(m_fAngle);

	__super::Update_RECT();
	return 0;
}

int CMonster::Late_Update() {
	return NOEVENT;
}

