#include "CCollisionMgr.h"
RECT rc{};
void CCollisionMgr::CollisionRect(list<CObj*>& obj1, list<CObj*>& obj2) {
	for (auto& OBj : obj1) {
		for (auto& OBj2 : obj2) {
			if (IntersectRect(&rc, &OBj->GetRect(), &OBj2->GetRect())) {
				OBj->GetDead() = true;
				OBj2->GetDead() = true;
			}
		}
	}
}


void CCollisionMgr::CollisionCircle(list<CObj*>& obj1, list<CObj*>& obj2) {
	for (auto& OBj : obj1) {
		for (auto& OBj2 : obj2) {
			if (Collision(OBj, OBj2)) {
				OBj->GetDead() = true;
				OBj->GetDead() = true;
			}
		}
	}
}

bool CCollisionMgr::Collision(CObj*& Monster, CObj*& ScrewBullet) {
	float radSum = (Monster->Get().fCX + ScrewBullet->Get().fCX) * 0.5f;
	float DistanceX = abs(Monster->Get().fX - ScrewBullet->Get().fX);
	float DistanceY = abs(Monster->Get().fY - ScrewBullet->Get().fY);
	float Distance = sqrtf(DistanceX * DistanceX + DistanceY * DistanceY);

	return radSum >= Distance;
}

void CCollisionMgr::CollisionRect2(list<CObj*>& obj1, list<CObj*>& obj2) {
	RECT IntersectRECT{};
	for (auto& OBj : obj1) {
		for (auto& OBj2 : obj2) {
			if (IntersectRect(&IntersectRECT, &OBj->GetRect(), &OBj2->GetRect())) {
				float Width = (float)IntersectRECT.right - IntersectRECT.left;
				float height = (float)IntersectRECT.bottom - IntersectRECT.top;

				if (Width >= height) {
					if (OBj->Get().fY <= OBj2->Get().fY) {  // 상 충돌(플레이어가 위)
						OBj->Get().fY -= height;
						OBj->Update_RECT();   // 바로 새로고침!
					}
					else {
						OBj->Get().fY += height;
						OBj->Update_RECT();
					}
				}
				else {
					if (OBj->Get().fX >= OBj2->Get().fX) {  // 우 충돌
						OBj->Get().fX += Width;
						OBj->Update_RECT();
					}
					else {
						OBj->Get().fX -= Width;
						OBj->Update_RECT();
					}
				}
			}
		}
	}
