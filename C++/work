void CPlayer::Initialize() {
	m_tInfo = { 400.f, 300.f, 50.f, 50.f };
	m_fSpeed = 10.f;
}

int CPlayer::Update() {
	if (GetAsyncKeyState(VK_LEFT)) {
		if (GetAsyncKeyState(VK_UP)) {
			m_tInfo.fX -= m_fSpeed / sqrtf(2.f);
			m_tInfo.fY -= m_fSpeed / sqrtf(2.f);
		}
		else if (GetAsyncKeyState(VK_DOWN)) {
			m_tInfo.fX -= m_fSpeed / sqrtf(2.f);
			m_tInfo.fY += m_fSpeed / sqrtf(2.f);
		}
		else
			m_tInfo.fX -= m_fSpeed;
	}
	if (GetAsyncKeyState(VK_RIGHT)) {
		if (GetAsyncKeyState(VK_UP)) {
			m_tInfo.fX += m_fSpeed / sqrtf(2.f);
			m_tInfo.fY -= m_fSpeed / sqrtf(2.f);
		}
		else if (GetAsyncKeyState(VK_DOWN)) {
			m_tInfo.fX += m_fSpeed / sqrtf(2.f);
			m_tInfo.fY += m_fSpeed / sqrtf(2.f);
		}
		else
			m_tInfo.fX += m_fSpeed;
	}
	if (GetAsyncKeyState(VK_UP)) {
		m_tInfo.fY -= m_fSpeed;
	}
	if (GetAsyncKeyState(VK_DOWN)) {
		m_tInfo.fY += m_fSpeed;
	}
	if (GetAsyncKeyState('A')) {
		m_fAngle += -15.0f * (PIE / 180.f);
	}
	if (GetAsyncKeyState('D')) {
		m_fAngle += 15.0f * (PIE / 180.f);
	}
	if (GetAsyncKeyState('V')) {
		m_pScrewBullet->push_back(CAbstactFactory<CScrewBullet>::CreatOBj(m_fEndX, m_fEndY,m_fAngle));
	}
	m_fEndX = m_tInfo.fX + (50.f * cosf(m_fAngle));
	m_fEndY = m_tInfo.fY + (50.f * sinf(m_fAngle));
	if (GetAsyncKeyState('S')) {
		m_pShield->push_back(CAbstactFactory<CShield>::CreatOBj(m_tInfo.fX, m_tInfo.fY));
	}
	
	for (auto& Shield : *m_pShield) {
		Shield->SetCenter(m_tInfo.fX, m_tInfo.fY);
	}
	if (GetAsyncKeyState(VK_SPACE)) {
		m_pBullet->push_back(CAbstactFactory<CBullet>::CreatOBj2(m_fEndX, m_fEndY,m_fAngle));
	} // 순서 상관 있다! 코드는 안전하게 짜는게 중요!
	for (auto& Bullet : *m_pBullet) {
		dynamic_cast<CBullet*>(Bullet)->COPY(m_pMonsterList);
	}
	__super::Update_RECT();
	return 0;
}

int CPlayer::Late_Update() {
	
	return NOEVENT;
}

void CPlayer::Render(HDC hDC) {
	Rectangle(hDC, m_tRect.left, m_tRect.top, m_tRect.right, m_tRect.bottom);
	MoveToEx(hDC, m_tInfo.fX, m_tInfo.fY, nullptr);
	LineTo(hDC, m_fEndX, m_fEndY);
}

