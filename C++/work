void CMaingame::Initialize() {
	m_hDC = GetDC(g_hWnd);            // 더블 버퍼링 해결 
	m_hBackDC = CreateCompatibleDC(m_hDC);
	m_hBitmap = CreateCompatibleBitmap(m_hDC, WINCX, WINCY);
	SelectObject(m_hBackDC, m_hBitmap);
	m_OBjList[Player].push_back(CAbstactFactory<CPlayer>::CreatOBj());
	dynamic_cast<CPlayer*>(m_OBjList[Player].front())->COPY(&m_OBjList[Bullet]);
	dynamic_cast<CPlayer*>(m_OBjList[Player].front())->COPY2(&m_OBjList[ScrewBullet]);
	dynamic_cast<CPlayer*>(m_OBjList[Player].front())->COPY3(&m_OBjList[Shield]);
	dynamic_cast<CPlayer*>(m_OBjList[Player].front())->COPY4(&m_OBjList[Monster]);
	for (int i = 0; i < 2; i++) {
		m_OBjList[Monster].push_back(CAbstactFactory<CMonster>::CreatOBj());
	
	}
	int i = 0;
	for (auto iter = m_OBjList[Monster].begin(); iter != m_OBjList[Monster].end(); iter++) {	
		(*iter)->Get().fX = 200;
		(*iter)->Get().fY = 200 + ((float)i*400);
		++i;
		dynamic_cast<CMonster*>(*iter)->COPY(m_OBjList[Player].front());
	}
	for (int i = 0; i < 9; i++) {
		m_OBjList[Wall].push_back(CAbstactFactory<CWall>::CreatOBj());
	}
	int j = 0;
	auto iter = m_OBjList[Wall].begin();
		for (int i = 0; i < 3; i++) {      // 이중루프의 논리
			for (int j = 0; j < 3; j++) {
				(*iter)->Get().fX = 200 + 100 * i;
				(*iter)->Get().fY = 200 + 100 * j;
				++iter;
			}
			if (iter == m_OBjList[Wall].end())
				break;
		}
}

void CMaingame::Update() {
	for (int i = 0; i < OBj_END; i++) {
		for (auto& OBj : m_OBjList[i]) {
			OBj->Update();
		}
	}
}
void CMaingame::Late_Update() {
	for (int i = 0; i < OBj_END; i++) {
		for (auto& OBj : m_OBjList[i]) {
			OBj->Late_Update();
		}
	}
	for (int i = 0; i < OBj_END; i++) {
		for (auto iter = m_OBjList[i].begin(); m_OBjList[i].end() != iter;) {
			if ((*iter)->GetDead() == true) {
				Safe_Delete<CObj*>(*iter);
				iter = m_OBjList[i].erase(iter);
			}
			else
				++iter;
		}
	}

	CCollisionMgr::CollisionRect(m_OBjList[Bullet], m_OBjList[Monster]);
	CCollisionMgr::CollisionRect(m_OBjList[Player], m_OBjList[Monster]);
	CCollisionMgr::CollisionRect(m_OBjList[Monster], m_OBjList[Shield]);
	CCollisionMgr::CollisionCircle(m_OBjList[Monster], m_OBjList[ScrewBullet]);
	CCollisionMgr::CollisionRect2(m_OBjList[Player], m_OBjList[Wall]); // 튕겨나오는건 반대방향으로 가면됨.
}

void CMaingame::Render() {
	Rectangle(m_hBackDC, 0, 0, WINCX, WINCY);
	Rectangle(m_hBackDC, 100, 100, WINCX - 100, WINCY - 100);
	
	for (int i = 0; i < OBj_END; i++) {
		for (auto& OBj : m_OBjList[i]) {
			OBj->Render(m_hBackDC);
		}
	}
	BitBlt(m_hDC, 0, 0, WINCX, WINCY, m_hBackDC, 0, 0, SRCCOPY);
	++m_iFPS;

	if (m_dwTime + 1000 < GetTickCount64())
	{
		swprintf_s(m_szFPS, L"FPS : %d", m_iFPS);
		/*TextOut(m_hDC, 100, 100, m_szFPS, lstrlen(m_szFPS));*/

		SetWindowText(g_hWnd, m_szFPS);

		m_dwTime = GetTickCount64();
		m_iFPS = 0;
	}

}

void CMaingame::Release() {
	for (int i = 0; i < OBj_END; i++) {
		for (auto& OBj : m_OBjList[i]) {
			Safe_Delete<CObj*>(OBj);
		}
		m_OBjList[i].clear();
	}
	ReleaseDC(g_hWnd, m_hDC);
}
