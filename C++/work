#include "CBullet.h"
CBullet::CBullet() {

}
CBullet::~CBullet() {

}

void CBullet::Initialize() {
	m_tInfo.fCX = 30.f;
	m_tInfo.fCY = 30.f;
	m_fSpeed = 3.f;
}

int CBullet::Update() { // 가까운 놈을 찾아가겠다!(내가 원하는 몹을 찾는 코드) + (따라가는 코드)
	if (m_pMonsterList == nullptr || m_pMonsterList->empty()) {
		m_tInfo.fX += m_fSpeed * cosf(m_fAngle2);
		m_tInfo.fY += m_fSpeed * sinf(m_fAngle2);
	} 
	else {
		for (auto& pMonster : *m_pMonsterList) {
			float MinDistance = 9999999.f;
			float DistanceX = pMonster->Get().fX - m_tInfo.fX;   
			float DistanceY = pMonster->Get().fY - m_tInfo.fY;
			float Distance = sqrtf((DistanceX * DistanceX) + (DistanceY * DistanceY));

			if (Distance < MinDistance) {
				MinDistance = Distance;
				m_pMonster = pMonster;
			}
		}
		float DistanceX = m_pMonster->Get().fX - m_tInfo.fX;
		float DistanceY = m_pMonster->Get().fY - m_tInfo.fY;
		m_fAngle = atan2f(DistanceY, DistanceX);

		m_tInfo.fX += m_fSpeed * cosf(m_fAngle);
		m_tInfo.fY += m_fSpeed * sinf(m_fAngle);
	}
	__super::Update_RECT();
	return 0;
}

int CBullet::Late_Update() {
	if (m_tInfo.fX <= 100 || m_tInfo.fX >= 700 || m_tInfo.fY <= 100 || m_tInfo.fY >= 500) {
		m_Dead = true;
	}
	return NOEVENT;
}

void CBullet::Render(HDC hDC) {
	Ellipse(hDC, m_tRect.left, m_tRect.top, m_tRect.right, m_tRect.bottom);
}

void CBullet::Release() {

}
